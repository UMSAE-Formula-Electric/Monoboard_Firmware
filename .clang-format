---
# FSAE Electric Project - clang-format Configuration
# Based on LLVM style with Barr-C Embedded Coding Standard compliance

BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
UseTab: Never
TabWidth: 4
IndentCaseLabels: true
IndentGotoLabels: false
IndentPPDirectives: AfterHash

# Line length (Barr-C: 100 chars max)
ColumnLimit: 100

# Spacing and alignment
SpaceAfterCStyleCast: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeSquareBrackets: false
SpaceInEmptyBlock: false
SpaceInEmptyParentheses: false
SpaceAroundPointerQualifiers: Default
Cpp11BracedListStyle: true

# Pointer alignment (declarator-attached: `CanFrame *frame`)
PointerAlignment: Right
DerivePointerAlignment: false

# Function formatting
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Brace styles: Allman for function bodies only; K&R everywhere else
# (structs, enums, control statements, initializer lists).
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  AfterClass: false
  AfterExternBlock: false
  AfterCaseLabel: false
  AfterNamespace: false
  BeforeElse: false
  BeforeWhile: false
  BeforeCatch: false
  SplitEmptyFunction: true
  SplitEmptyRecord: false
  IndentBraces: false
IndentExternBlock: NoIndent

# Operators
BreakAfterJavaFieldAnnotations: false
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true

# Comments
AlignTrailingComments: true
ReflowComments: true
SpacesBeforeTrailingComments: 2

# Includes: keep the author's blank-line-separated groups, sort within each.
IncludeBlocks: Preserve

# Function parameters: wrapped continuations align under the first
# argument; arguments may share a line (as in the HAL init calls).
BinPackParameters: false
BinPackArguments: true
AlignAfterOpenBracket: Align

# Alignment: line up runs of declarations, assignments, struct-field
# initializers and trailing comments -- the house style in the driver
# and interface files (e.g. the `.init = / .send =` vtables).
AlignConsecutiveAssignments: true
AlignConsecutiveBitFields: true
AlignConsecutiveDeclarations: true
AlignConsecutiveMacros: true
AlignEscapedNewlines: Left
AlignOperands: Align

# No spaces in brackets
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInConditionalStatement: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Line breaking
PenaltyBreakAssignment: 100
PenaltyBreakBeforeFirstCallParameter: 1
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyBreakTemplateDeclaration: 10
PenaltyExcessCharacter: 1000
PenaltyReturnTypeOnItsOwnLine: 60

# Sorting and organization
SortIncludes: true
SortUsingDeclarations: false

# Other
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
PackConstructorInitializers: BinPack
NamespaceIndentation: All
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4

# C-specific
Language: Cpp
