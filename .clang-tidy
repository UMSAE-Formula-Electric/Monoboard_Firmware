---
# clang-tidy for the Monoboard firmware -- C99, BARR-C, FreeRTOS + STM32 HAL.
#
# Complements the compiler (-Wall -Wextra -Werror -Wconversion -Wshadow) and
# cppcheck: clang-tidy adds the path-sensitive Clang Static Analyzer plus the
# bugprone / cert families. C++-only check groups (modernize, cppcoreguidelines,
# hicpp, google, fuchsia, ...) are intentionally left out.
#
# Run:  cmake --build build/desktop --target tidy
# This file is the authority on which checks run; WarningsAsErrors makes any
# finding fail the target.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -cert-err33-c,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-unused-parameters,

WarningsAsErrors: '*'

# Report findings from first-party headers only -- not the vendored HAL/CMSIS
# (production/cubemx/**) or FreeRTOS-Kernel (lib/**).
HeaderFilterRegex: '.*/production/(interfaces|proto|app|services|drivers|src|tests)/'
SystemHeaders: false
FormatStyle: file

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'
