{
  "version": 3,
  "configurePresets": [
    {
      "name": "mcu-debug",
      "displayName": "STM32F446 Debug",
      "binaryDir": "${sourceDir}/build/mcu-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mcu-release",
      "displayName": "STM32F446 Release (LTO)",
      "binaryDir": "${sourceDir}/build/mcu-release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "desktop",
      "displayName": "Desktop tests + sim (host GCC, FreeRTOS POSIX port)",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "mcu-debug",   "configurePreset": "mcu-debug" },
    { "name": "mcu-release", "configurePreset": "mcu-release" },
    { "name": "desktop",     "configurePreset": "desktop" }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": { "outputOnFailure": true }
    }
  ]
}
