# Doxyfile for FSAE Electric Project
# Generates API documentation from the first-party firmware sources.
# Regenerate with: cmake --build build/<preset> --target docs
# Output (HTML + warning log + tag file) lands in ./docs and is gitignored.

PROJECT_NAME           = "FSAE Electric Vehicle Control System"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "FreeRTOS-based motor control and telemetry system"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = ./docs
CREATE_SUBDIRS         = NO

# Input settings -- the layered firmware tree plus the top-level docs.
# production/cubemx is the CubeMX/HAL vendor drop and is not first-party.
INPUT                  = ./README.md ./ARCHITECTURE.md ./production
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = ./production/cubemx
EXCLUDE_PATTERNS       = */cubemx/* *_it.c
USE_MDFILE_AS_MAINPAGE = ./README.md

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# HTML customization
HTML_DYNAMIC_SECTIONS  = YES
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO

# Extraction. The codebase documents with plain /* */ block comments, so
# EXTRACT_ALL keeps undocumented entities in the output; the undocumented
# warnings are silenced to match (flip them back on once /** */ doc
# comments are the norm).
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_IN_BODY_DOCS      = NO

# Comment formatting
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_FOR_C  = YES

# Source browser
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
STRIP_FROM_PATH        = ./
STRIP_FROM_INC_PATH    = ./production

# Warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = ./docs/doxygen_warnings.txt

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = \
    "DOXYGEN" \
    "configUSE_PREEMPTION=1" \
    "configMAX_PRIORITIES=5" \
    "USE_HAL_DRIVER"

# Diagrams (graphviz is a build-host dependency for the docs target).
HAVE_DOT               = YES
DOT_PATH               =
DOT_IMAGE_FORMAT       = svg
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES

# Lists
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
GENERATE_TESTLIST      = YES
GENERATE_TODOLIST      = YES

# Index
ALPHABETICAL_INDEX     = YES

# Tag file (for cross-referencing with other projects)
GENERATE_TAGFILE       = ./docs/fsae.tags

# Performance
CLANG_ASSISTED_PARSING = NO
NUM_PROC_THREADS       = 4

ALIASES               += \
    "note=\xrefitem notes \"Note\" \"Notes\"" \
    "warning=\xrefitem warnings \"Warning\" \"Warnings\"" \
    "bug=\xrefitem bugs \"Bug\" \"Bugs\"" \
    "todo=\xrefitem todos \"Todo\" \"Todo Items\""
